#!/bin/sh
# Единая точка входа CUDY Home Gateway.

set -eu

HG_LIBDIR="${HG_LIBDIR:-/usr/lib/home-gateway}"
COMMON_MODULE="${HG_LIBDIR}/common.sh"

if [ ! -r "$COMMON_MODULE" ]; then
    printf 'gateway: не найден системный модуль: %s\n' "$COMMON_MODULE" >&2
    exit 70
fi

# shellcheck source=/dev/null
. "$COMMON_MODULE"

print_help() {
    cat <<'EOF_HELP'
CUDY Home Gateway

Использование:
  gateway help             Показать эту справку
  gateway version          Показать версию CLI
  gateway status           Показать системный статус роутера
  gateway status --json    Вывести системный статус в JSON
  gateway health           Показать нормализованное health-состояние
  gateway health --json    Вывести health-состояние в JSON
  gateway doctor           Проверить окружение и зависимости
  gateway selftest         Проверить установку Gateway CLI
  gateway telegram get-me  Проверить Telegram Bot API
  gateway telegram get-updates [offset] [timeout]
                           Получить updates без изменения data plane
  gateway telegram send-message CHAT_ID TEXT [REPLY_MARKUP]
                           Отправить сообщение через Telegram Bot API
  gateway telegram edit-message CHAT_ID MESSAGE_ID TEXT [REPLY_MARKUP]
                           Обновить сообщение Telegram
  gateway telegram answer-callback CALLBACK_QUERY_ID [TEXT]
                           Завершить Telegram callback query

Health и Telegram работают только как control plane.
Команды изменения сетевой конфигурации на этапе 0.5 не реализованы.
EOF_HELP
}

main() {
    command="${1:-help}"

    case "$command" in
        help|-h|--help)
            print_help
            ;;
        version|-V|--version)
            hg_print_version
            ;;
        status)
            hg_load_module status

            if [ "$#" -eq 1 ]; then
                hg_status_print
            elif [ "$#" -eq 2 ] && [ "$2" = '--json' ]; then
                hg_status_print_json
            else
                hg_error 'использование: gateway status [--json]'
                return "$HG_EXIT_USAGE"
            fi
            ;;
        health)
            hg_load_module health

            if [ "$#" -eq 1 ]; then
                hg_health_print
            elif [ "$#" -eq 2 ] && [ "$2" = '--json' ]; then
                hg_health_print_json
            else
                hg_error 'использование: gateway health [--json]'
                return "$HG_EXIT_USAGE"
            fi
            ;;
        telegram)
            hg_load_module telegram

            subcommand="${2:-}"

            case "$subcommand" in
                get-me)
                    if [ "$#" -ne 2 ]; then
                        hg_error 'использование: gateway telegram get-me'
                        return "$HG_EXIT_USAGE"
                    fi
                    hg_telegram_get_me
                    ;;
                get-updates)
                    if [ "$#" -gt 4 ]; then
                        hg_error 'использование: gateway telegram get-updates [offset] [timeout]'
                        return "$HG_EXIT_USAGE"
                    fi
                    hg_telegram_get_updates "${3:-}" "${4:-0}"
                    ;;
                send-message)
                    if [ "$#" -lt 4 ] || [ "$#" -gt 5 ]; then
                        hg_error 'использование: gateway telegram send-message CHAT_ID TEXT [REPLY_MARKUP]'
                        return "$HG_EXIT_USAGE"
                    fi
                    hg_telegram_send_message "$3" "$4" "${5:-}"
                    ;;
                edit-message)
                    if [ "$#" -lt 5 ] || [ "$#" -gt 6 ]; then
                        hg_error 'использование: gateway telegram edit-message CHAT_ID MESSAGE_ID TEXT [REPLY_MARKUP]'
                        return "$HG_EXIT_USAGE"
                    fi
                    hg_telegram_edit_message "$3" "$4" "$5" "${6:-}"
                    ;;
                answer-callback)
                    if [ "$#" -lt 3 ] || [ "$#" -gt 4 ]; then
                        hg_error 'использование: gateway telegram answer-callback CALLBACK_QUERY_ID [TEXT]'
                        return "$HG_EXIT_USAGE"
                    fi
                    hg_telegram_answer_callback "$3" "${4:-}"
                    ;;
                *)
                    hg_error 'использование: gateway telegram {get-me|get-updates|send-message|edit-message|answer-callback}'
                    return "$HG_EXIT_USAGE"
                    ;;
            esac
            ;;
        doctor)
            if [ "$#" -ne 1 ]; then
                hg_error 'использование: gateway doctor'
                return "$HG_EXIT_USAGE"
            fi

            hg_load_module doctor
            hg_doctor_run
            ;;
        selftest)
            if [ "$#" -ne 1 ]; then
                hg_error 'использование: gateway selftest'
                return "$HG_EXIT_USAGE"
            fi

            hg_load_module selftest
            hg_selftest_run "$0"
            ;;
        *)
            hg_error "неизвестная команда: $command"
            printf '\n' >&2
            print_help >&2
            return "$HG_EXIT_USAGE"
            ;;
    esac
}

main "$@"
